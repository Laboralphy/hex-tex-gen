              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "additionalProperties": false
        },
        "cracks": {
          "description": "cracks running across stones",
          "default": {},
          "type": "object",
          "properties": {
            "ratio": {
              "description": "ratio of cracked stones, in [0, 1]; when unset, derived from age",
              "type": "number",
              "minimum": 0,
              "maximum": 1
