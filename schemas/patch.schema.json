              "scale": "layout",
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "minJointOffset": {
              "default": 5,
              "description": "minimum horizontal distance between a joint and the joints of adjacent rows (layout: scales with the patch)",
              "scale": "layout",
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "mortar": {
          "description": "joints between stones",
          "default": {},
