              "scale": "layout",
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "heightVariation": {
              "default": 0.2,
              "description": "random height variation between rows, in [0, 1) (layout: scales with the patch)",
              "scale": "layout",
              "type": "number",
