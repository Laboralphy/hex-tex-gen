{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hex-tex-gen patch",
  "description": "a patch: a template and its parameters",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "$schema": {
          "description": "JSON Schema of this file, for editors",
          "type": "string"
        },
        "extends": {
          "description": "parent patch file, relative to this file, deep-merged under this one",
          "type": "string"
        },
        "template": {
          "const": "ashlar",
          "description": "Dressed stone wall: rows of stones of random width"
        },
        "seed": {
          "description": "seed of this patch, unless the placement sets one",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "size": {
          "default": [64, 64],
          "description": "own size of the patch in pixels; layout values are expressed at this size",
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
